# 如果你想使用 OpenAI
OPENAI_API_KEY="sk-..."

# 如果你最终想使用 Google Vertex 
# 你需要在本地执行 gcloud auth application-default login 或设置 CREDENTIALS
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/key.json"
# GOOGLE_CLOUD_PROJECT="your-project-id"

# 或者如果你用第三方的 OpenAI 兼容接口，可以直接把 URL 和 KEY 写在这里
# OPENAI_API_BASE="https://api.your-provider.com/v1"
# OPENAI_API_KEY="xxx"
